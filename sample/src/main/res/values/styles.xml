<resources>
    <style name="SampleTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#00D86C</item>
        <item name="android:colorControlActivated">#00D86C</item>
        <item name="android:colorControlHighlight">#3300D86C</item>
        <item name="android:textColorHighlight">#6600D86C</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="SettingsTheme" parent="SampleTheme">
        <item name="android:windowAnimationStyle">@style/SettingsWindowAnimation</item>
    </style>
    <style name="SettingsWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/settings_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/settings_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/settings_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/settings_pop_exit</item>
    </style>
</resources>
