    "enable_ssh_and_install_tmux_on_your_computer_first_your_private_k": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable SSH and install tmux on your computer first. Your private key is generated and encrypted on this device; only the public key is installed on the computer. The QR code pins the HTTPS certificate and contains a short-lived one-time token. Windows uses WSL2; the script may request system authorization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑需要先开启 SSH 并安装 tmux。手机生成私钥并保存在本机加密存储；电脑只安装公钥。二维码固定 HTTPS 证书和短时有效的一次性令牌。Windows 通过 WSL2 连接，脚本可能请求系统授权。"
          }
        }
      }
    },
