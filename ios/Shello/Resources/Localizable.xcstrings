          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Windows PowerShell 中运行。脚本配置 WSL2 并转发 SSH 和配对端口；连接的是 WSL2 内的 Linux，不是原生 PowerShell 会话。"
          }
        }
      }
