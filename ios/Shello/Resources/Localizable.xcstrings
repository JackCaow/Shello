    "active_ssh_sessions_keep_fetching_events_in_the_background_if_no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active SSH sessions keep fetching events in the background. If no connection is active, the app is force-stopped or networking is suspended, events sync when you reopen the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切后台后，活动 SSH 会话会继续获取事件。没有活动连接、强行停止应用或系统断网时，事件将在重新打开后同步。"
          }
        }
      }
    },
