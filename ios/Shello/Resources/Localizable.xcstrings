    "input_c_b_s_t_send_key_combinations_in_sequence_c_ctrl_a_m_opt_s_shift_d_cmd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "C-b, S-t: send key combinations in sequence. C=Ctrl, A/M=Opt, S=Shift, D=Cmd. F1–F12 are supported.\ntext:/compact: insert text; enable automatic Enter to submit. Commas and line breaks in text are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "C-b, S-t：依次发送组合键。C=Ctrl，A/M=Opt，S=Shift，D=Cmd。支持 F1–F12。\ntext:/compact：插入文本；打开自动回车后提交。文本中的逗号和换行会保留。"
          }
        }
      }
    },
